ADMIN_KEY=replace-with-a-long-random-key
MASTER_KEY=replace-with-64-hex-characters
HOST=127.0.0.1
PORT=3080
BASE_URL=http://127.0.0.1:3080
DATA_DIR=./data
PYTHON_BIN=python3
# Codex 内部调用模型，与客户端请求的图片模型分别配置
CODEX_RESPONSES_MODEL=gpt-6.1-sol
# 可选：经授权可使用且支持设备码流程的 OAuth 客户端
# CODEX_OAUTH_CLIENT_ID=your-client-id
# 可选：常驻 Python 进程池的进程数上限（默认 4）；ADAPTER_POOL=0 回退为每张图片一个进程
# ADAPTER_WORKERS=4
# ADAPTER_POOL=0
