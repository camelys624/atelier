{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "esModuleInterop": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "types": ["bun", "vite/client"],
    "baseUrl": ".", "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "server", "scripts", "test", "vite.config.ts"]
}
