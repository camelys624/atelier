{
  "name": "atelier-image-service",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev": "bun scripts/dev.ts",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "bun --bun node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173",
    "build": "bun --bun node_modules/vite/bin/vite.js build",
