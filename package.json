    "@tanstack/react-start": "1.169.4",
    "ali-oss": "6.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.14",
    "lucide-react": "^1.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/ali-oss": "^6.23.3",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
